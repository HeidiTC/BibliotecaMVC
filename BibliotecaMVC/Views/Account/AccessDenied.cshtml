@{
    ViewData["Title"] = "Acceso denegado";

    // Rol del usuario para mostrarlo en el mensaje (mismo criterio que el _Layout)
    var rolActual = User.IsInRole("Admin") ? "Admin" : User.IsInRole("Bibliotecario") ? "Bibliotecario" : "Usuario";
}

<!-- Vista que se muestra cuando el usuario inició sesión pero no tiene el rol necesario -->
<div class="auth-contenedor">
    <div class="card auth-card aviso-card">
        <div class="auth-encabezado">
            <div class="aviso-icono">🔒</div>
            <h1>Acceso denegado</h1>
            <p>No tienes permiso para esta operación</p>
        </div>

        <div class="card-body p-4">
            <p>
                Tu usuario <strong>@(User.Identity?.Name)</strong> tiene el rol
                <span class="badge bg-secondary">@rolActual</span>.
                Agregar, editar o eliminar libros solo lo pueden hacer los roles <strong>Admin</strong> y <strong>Bibliotecario</strong>.
            </p>

            @* Vista parcial reutilizable con los botones de navegación *@
            <partial name="_OpcionesNavegacion" />
        </div>
    </div>
</div>
