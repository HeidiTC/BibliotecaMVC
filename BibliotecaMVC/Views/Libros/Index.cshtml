@model IEnumerable<BibliotecaMVC.Models.Libro>

@{
    ViewData["Title"] = "Catálogo de Libros";

    
    var esAdmin = User.IsInRole("Administrador");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Catálogo de Libros</h1>
    @if (esAdmin)
    {
        <a asp-action="Create" class="btn btn-success">Nuevo Libro</a>
    }
</div>

@if (!esAdmin)
{
    <div class="alert alert-info">
        Estás en modo consulta. Solo el rol <strong>Administrador</strong> puede agregar, editar o eliminar libros.
    </div>
}

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>ID</th>
            <th>Título</th>
            <th>Autor</th>
            <th>Categoría</th>
            <th>Precio</th>
            <th>Estado</th>
            @if (esAdmin)
            {
                <th>Acciones</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var libro in Model)
        {
            <tr>
                <td>@libro.ID</td>
                <td>@libro.Titulo</td>
                <td>@libro.Autor</td>
                <td>@libro.Categoria</td>
                <td>@libro.Precio</td>
                <td>
                    @if (libro.Disponible)
                    {
                        <span class="badge bg-success">Disponible</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">No disponible</span>
                    }
                </td>
                @if (esAdmin)
                {
                <td>
                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@libro.ID" class="btn btn-outline-primary btn-sm">
                            Editar
                        </a>

                        <form asp-action="Delete"
                              asp-route-id="@libro.ID"
                              method="post"
                              style="display:inline;"
                              onsubmit="return confirmarEliminacion();">

                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                Eliminar
                            </button>
                        </form>
                    </div>
                </td>
                }
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            Swal.fire({
                icon: 'success',
                title: 'Éxito',
                text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["SuccessMessage"])),
                timer: 2000,
                showConfirmButton: false
            });
        </script>
    }

    <script>
        function confirmarEliminacion() {
            return confirm("¿Está seguro de eliminar este libro?");
        }
    </script>
}