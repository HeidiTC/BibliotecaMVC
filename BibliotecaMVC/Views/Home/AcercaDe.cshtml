@{
    ViewData["Title"] = "Acerca de";
}

<header class="about-header">
    <h1>BibliotecaMVC</h1>
    <p>
        Sistema web para la gestión y consulta de información
        de nuestra biblioteca virtual.
    </p>
</header>

<main class="about-container">

    <section class="about-content">

        <article class="info-card">
            <h2>¿Quiénes somos?</h2>

            <p>
                BibliotecaMVC es una aplicación web desarrollada para facilitar
                la consulta y organización de información relacionada con libros
                y autores.
            </p>

            <p>
                Nuestro objetivo es ofrecer una experiencia sencilla y organizada
                para que los usuarios puedan explorar la información disponible
                en la biblioteca virtual.
            </p>
        </article>

        <article class="info-card">
            <h2>Misión</h2>

            <p>
                Facilitar el acceso y la consulta de información bibliográfica
                mediante una plataforma web organizada y fácil de utilizar.
            </p>
        </article>

        <article class="info-card">
            <h2>Visión</h2>

            <p>
                Ser una biblioteca virtual moderna que contribuya al acceso
                eficiente de la información y al aprendizaje de sus usuarios.
            </p>
        </article>

    </section>


    <section class="about-figure-section">
        <figure>
            <img src="https://picsum.photos/900/300"
                 alt="Imagen representativa de una biblioteca virtual"
                 class="about-image">

            <figcaption>
                Biblioteca virtual desarrollada con ASP.NET Core MVC.
            </figcaption>
        </figure>
    </section>

</main>