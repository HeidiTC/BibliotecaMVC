@model ErrorViewModel
@{
    ViewData["Title"] = "Error";

    // Según el código HTTP cambia el título y el mensaje (sin mostrar detalles técnicos al usuario)
    string titulo = "Algo salió mal";
    string mensaje = "Ocurrió un problema al procesar tu solicitud. Intenta de nuevo en unos minutos.";

    if (Model.CodigoEstado == 404)
    {
        titulo = "Página no encontrada";
        mensaje = "El libro o la página que buscas no existe o fue eliminado.";
    }
    else if (Model.CodigoEstado == 400)
    {
        titulo = "Solicitud no válida";
        mensaje = "Los datos enviados no son correctos. Revisa la información e inténtalo de nuevo.";
    }
}

@* Se reutiliza el mismo diseño de tarjeta del Login (semana 11) *@
<div class="auth-contenedor">
    <div class="card auth-card aviso-card">
        <div class="auth-encabezado">
            <div class="aviso-icono">⚠️</div>
            <h1>@titulo</h1>
            @if (Model.CodigoEstado != null)
            {
                <p>Error @Model.CodigoEstado</p>
            }
        </div>

        <div class="card-body p-4">
            <p>@mensaje</p>

            @* Vista parcial reutilizable con los botones de navegación *@
            <partial name="_OpcionesNavegacion" />

            @* El código de referencia no es información sensible: solo sirve para buscar el error en los logs *@
            @if (Model.ShowRequestId && Model.CodigoEstado == null)
            {
                <p class="text-muted small mt-3 mb-0">Código de referencia: @Model.RequestId</p>
            }
        </div>
    </div>
</div>
