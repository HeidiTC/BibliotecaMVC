@model BibliotecaMVC.Models.Autor

@{
    ViewData["Title"] = "Detalles del Autor";
}
<h1>@Model.Nombre</h1>
<dl class="row">
    <dt class="col-sm-3">
        Nacionalidad
    </dt>

    <dd class="col-sm-9">
        @Model.Nacionalidad
    </dd>
    <dt class="col-sm-3">
        Fecha de nacimiento
    </dt>

    <dd class="col-sm-9">
        @Model.FechaNacimiento.ToString("yyyy-MM-dd")
    </dd>
    <dt class="col-sm-3">
        Edad
    </dt>

    <dd class="col-sm-9">
        @(DateTime.Now.Year - Model.FechaNacimiento.Year)
    </dd>

</dl>

<a asp-action="Index" class="btn btn-primary">
    Volver al listado
</a>
